{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bridge",
  "version": "0.21.0",
  "identifier": "org.translationcore.aibridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bridge",
        "decorations": false,
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#F3F4F6",
        "dragDropEnabled": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Bridge",
        "width": 480,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#FFFFFF",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bridge-engine",
      "binaries/bridge-usfm-checker"
    ],
    "resources": ["resources/", "language_packs/"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
