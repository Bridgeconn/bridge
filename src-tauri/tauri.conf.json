{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bridge",
  "version": "0.25.0",
  "identifier": "org.translationcore.aibridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bridge",
        "decorations": false,
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#F3F4F6",
        "dragDropEnabled": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Bridge",
        "width": 480,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#FFFFFF",
        "dragDropEnabled": false
      },
      {
        "label": "review-queue",
        "url": "review.html",
        "title": "Review notes · Bridge",
        "width": 1180,
        "height": 740,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "alignment",
        "url": "alignment.html",
        "title": "Alignment · Bridge",
        "width": 1180,
        "height": 740,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "panel-source",
        "url": "panel.html?panel=source",
        "title": "Source text · Bridge",
        "width": 560,
        "height": 640,
        "minWidth": 360,
        "minHeight": 320,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "panel-reference",
        "url": "panel.html?panel=reference",
        "title": "Reference · Bridge",
        "width": 560,
        "height": 640,
        "minWidth": 360,
        "minHeight": 320,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "panel-paratext",
        "url": "panel.html?panel=paratext",
        "title": "Paratext notes · Bridge",
        "width": 560,
        "height": 640,
        "minWidth": 360,
        "minHeight": 320,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "panel-review",
        "url": "panel.html?panel=review",
        "title": "Review · Bridge",
        "width": 560,
        "height": 640,
        "minWidth": 360,
        "minHeight": 320,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/Bridgeconn/bridge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Bridge Connectivity Solutions Pvt. Ltd.",
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bridge-engine",
      "binaries/bridge-usfm-checker"
    ],
    "resources": [
      "resources/",
      "language_packs/"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
