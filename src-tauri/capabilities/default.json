{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window and the startup splash window (#287)",
  "windows": ["main", "splash"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "shell:allow-execute",
    "shell:allow-spawn",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bridge-engine",
          "sidecar": true
        }
      ]
    }
  ]
}
